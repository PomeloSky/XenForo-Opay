<?xml version="1.0" encoding="utf-8"?>
<templates>
  <template type="admin" title="payment_profile_opay" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:textboxrow name="options[merchant_id]"
	value="{$profile.options.merchant_id}"
	maxlength="10"
	label="{{ phrase('opay_merchant_id') }}"
	hint="{{ phrase('opay_merchant_id_explain') }}" />

<xf:textboxrow name="options[hash_key]"
	value="{$profile.options.hash_key}"
	label="{{ phrase('opay_hash_key') }}"
	hint="{{ phrase('opay_hash_key_explain') }}" />

<xf:textboxrow name="options[hash_iv]"
	value="{$profile.options.hash_iv}"
	label="{{ phrase('opay_hash_iv') }}"
	hint="{{ phrase('opay_hash_iv_explain') }}" />

<xf:radiorow name="options[service_provider]"
	value="{{ $profile.options.service_provider ?: 'opay' }}"
	label="{{ phrase('opay_service_provider') }}"
	hint="{{ phrase('opay_service_provider_explain') }}">
	<xf:option value="opay" label="{{ phrase('opay_service_provider.opay') }}" />
	<xf:option value="ecpay" label="{{ phrase('opay_service_provider.ecpay') }}" />
</xf:radiorow>

<xf:radiorow name="options[environment]"
	value="{{ $profile.options.environment ?: 'stage' }}"
	label="{{ phrase('opay_environment') }}"
	hint="{{ phrase('opay_environment_explain') }}">
	<xf:option value="stage" label="{{ phrase('opay_environment.stage') }}" />
	<xf:option value="production" label="{{ phrase('opay_environment.production') }}" />
</xf:radiorow>

<xf:radiorow name="options[encrypt_type]"
	value="{{ $profile.options.encrypt_type ?: 'sha256' }}"
	label="{{ phrase('opay_encrypt_type') }}"
	hint="{{ phrase('opay_encrypt_type_explain') }}">
	<xf:option value="sha256" label="{{ phrase('opay_encrypt_type.sha256') }}" />
	<xf:option value="md5" label="{{ phrase('opay_encrypt_type.md5') }}" />
</xf:radiorow>

<xf:checkboxrow label="{{ phrase('opay_payment_methods') }}"
	hint="{{ phrase('opay_payment_methods_explain') }}">
	<xf:option name="options[pm_credit]"
		selected="{{ in_array('Credit', $profile.options.payment_methods ?: ['Credit']) }}"
		label="{{ phrase('opay_payment_method.Credit') }}" />
	<xf:option name="options[pm_webatm]"
		selected="{{ in_array('WebATM', $profile.options.payment_methods ?: []) }}"
		label="{{ phrase('opay_payment_method.WebATM') }}" />
	<xf:option name="options[pm_atm]"
		selected="{{ in_array('ATM', $profile.options.payment_methods ?: []) }}"
		label="{{ phrase('opay_payment_method.ATM') }}" />
	<xf:option name="options[pm_cvs]"
		selected="{{ in_array('CVS', $profile.options.payment_methods ?: []) }}"
		label="{{ phrase('opay_payment_method.CVS') }}" />
</xf:checkboxrow>

<xf:numberboxrow name="options[atm_expire_date]"
	value="{{ $profile.options.atm_expire_date ?: 3 }}"
	min="1" max="60" step="1"
	label="{{ phrase('opay_atm_expire_date') }}"
	hint="{{ phrase('opay_atm_expire_date_explain') }}" />

<xf:numberboxrow name="options[cvs_expire_minutes]"
	value="{{ $profile.options.cvs_expire_minutes ?: 10080 }}"
	min="60" max="43200" step="60"
	label="{{ phrase('opay_cvs_expire_minutes') }}"
	hint="{{ phrase('opay_cvs_expire_minutes_explain') }}" />
]]></template>

  <template type="public" title="payment_return_opay" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:title>付款處理中…</xf:title>

<div class="blockMessage">正在帶您回到站內，請稍候…</div>
<a class="button button--primary" href="{$redirectUrl}">繼續</a>

<script>
	setTimeout(function () { window.location.replace({$redirectUrl|for_attr}); }, 100);
</script>
]]></template>

  <template type="public" title="payment_initiate_opay" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:title>{{ phrase('opay.payment_initiating') }}</xf:title>

<div class="blockMessage">
	<p>{{ phrase('opay.payment_initiating') }}</p>
</div>

<form id="OpayAutoSubmit" method="post" action="{$action}">
	<xf:foreach loop="$params" key="$k" value="$v">
		<input type="hidden" name="{$k}" value="{$v}" />
	</xf:foreach>
	<noscript>
		<button type="submit" class="button button--primary">{{ phrase('opay.click_if_not_redirected') }}</button>
	</noscript>
</form>

<xf:js>
	(function() {
		var form = document.getElementById('OpayAutoSubmit');
		if (form) { form.submit(); }
	})();
</xf:js>
]]></template>

  <template type="admin" title="yucts_opay_order_list" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:title>{{ phrase('opay.order_list') }}</xf:title>

<xf:form action="{{ link('opay/orders') }}" method="get" class="block">
	<div class="block-container">
		<h2 class="block-header">{{ phrase('opay.search') }}</h2>
		<div class="block-body">
			<xf:textboxrow name="mtn" value="{$filters.mtn}" label="{{ phrase('opay.merchant_trade_no') }}" />
			<xf:textboxrow name="username" value="{$filters.username}" label="{{ phrase('opay.purchaser') }}" />
			<xf:selectrow name="status" value="{$filters.status}" label="{{ phrase('opay.status') }}">
				<xf:foreach loop="$statuses" key="$key" value="$label">
					<xf:option value="{$key}">{$label}</xf:option>
				</xf:foreach>
			</xf:selectrow>
		</div>
		<xf:submitrow icon="search" submit="{{ phrase('opay.search') }}" />
	</div>
</xf:form>

<xf:if is="$transactions is not empty">
	<div class="block">
		<div class="block-container">
			<h2 class="block-header">
				{{ phrase('opay.order_list') }} <span class="block-headerCounter">({$total|number})</span>
			</h2>
			<ol class="block-body">
				<xf:foreach loop="$transactions" value="$t">
					<li class="block-row block-row--separated">
						<div class="contentRow">
							<div class="contentRow-figure">
								<xf:if is="$t.status == 'paid'"><i class="fa fa-check-circle" style="color:#2e8540;font-size:32px;"></i>
								<xf:elseif is="$t.status == 'pending'" /><i class="fa fa-clock-o" style="color:#b58900;font-size:32px;"></i>
								<xf:elseif is="$t.status == 'refunded'" /><i class="fa fa-undo" style="color:#268bd2;font-size:32px;"></i>
								<xf:elseif is="$t.status == 'cancelled'" /><i class="fa fa-ban" style="color:#888;font-size:32px;"></i>
								<xf:else /><i class="fa fa-times-circle" style="color:#dc322f;font-size:32px;"></i>
								</xf:if>
							</div>
							<div class="contentRow-main">
								<h3 class="contentRow-title">
									<a href="{{ link('opay/orders/view', $t) }}">{$t.merchant_trade_no}</a>
									<span class="label label--accent">{$t.status_phrase}</span>
								</h3>
								<div class="contentRow-minor">
									<ul class="listInline listInline--bullet">
										<li><strong>{{ phrase('opay.amount') }}:</strong> {$t.amount|number} {$t.currency}</li>
										<li><strong>{{ phrase('opay.purchaser') }}:</strong>
											<xf:if is="$t.User"><a href="{{ link('users', $t.User) }}">{$t.User.username}</a>
											<xf:else />{$t.username}</xf:if>
										</li>
										<li><strong>{{ phrase('opay.payment_type') }}:</strong> {{ $t.payment_type ?: $t.payment_method }}</li>
										<li><strong>TradeNo:</strong> <code>{{ $t.trade_no ?: '(pending)' }}</code></li>
										<li><strong>{{ phrase('opay.create_date') }}:</strong> <xf:date time="{$t.create_date}" /></li>
									</ul>
								</div>
							</div>
							<div class="contentRow-figure contentRow-figure--fixedSmall">
								<a href="{{ link('opay/orders/view', $t) }}" class="button button--link button--small">{{ phrase('view') }}</a>
							</div>
						</div>
					</li>
				</xf:foreach>
			</ol>
		</div>
	</div>

	<xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="opay/orders" params="{$filters}" wrapperclass="block" />
<xf:else />
	<div class="blockMessage blockMessage--none">{{ phrase('opay.no_orders') }}</div>
</xf:if>
]]></template>

  <template type="admin" title="yucts_opay_order_view" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:title>{{ phrase('opay.order_view') }} — {$transaction.merchant_trade_no}</xf:title>

<xf:pageaction>
	<a href="{{ link('opay/orders') }}" class="button button--link">&laquo; {{ phrase('back') }}</a>
	<a href="{{ link('opay/orders/edit', $transaction) }}" class="button">{{ phrase('edit') }}</a>
	<a href="{{ link('opay/orders/query', $transaction) }}" class="button">{{ phrase('opay_action.query') }}</a>
	<xf:if is="$transaction.canRefund()">
		<a href="{{ link('opay/orders/refund', $transaction) }}" class="button">{{ phrase('opay_action.refund') }}</a>
	</xf:if>
	<xf:if is="$transaction.canManuallyCancel()">
		<a href="{{ link('opay/orders/cancel', $transaction) }}" class="button">{{ phrase('opay_action.cancel') }}</a>
	</xf:if>
	<xf:if is="$transaction.canManuallyComplete()">
		<a href="{{ link('opay/orders/complete', $transaction) }}" class="button button--cta">{{ phrase('opay_action.complete') }}</a>
	</xf:if>
</xf:pageaction>

<div class="block">
	<div class="block-container">
		<h2 class="block-header">{{ phrase('opay_block.basic_info') }}</h2>
		<table class="dataList-table">
			<tbody>
				<tr class="dataList-row">
					<th class="dataList-cell" style="width:200px; font-weight:bold; background:#f7f7f7;">{{ phrase('opay.status') }}</th>
					<td class="dataList-cell">
						<xf:if is="$transaction.status == 'paid'"><span class="label label--green">{$transaction.status_phrase}</span>
						<xf:elseif is="$transaction.status == 'pending'" /><span class="label label--yellow">{$transaction.status_phrase}</span>
						<xf:elseif is="$transaction.status == 'refunded'" /><span class="label label--primary">{$transaction.status_phrase}</span>
						<xf:elseif is="$transaction.status == 'cancelled'" /><span class="label">{$transaction.status_phrase}</span>
						<xf:else /><span class="label label--red">{$transaction.status_phrase}</span>
						</xf:if>
					</td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">{{ phrase('opay.amount') }}</th>
					<td class="dataList-cell"><strong style="font-size:1.2em; color:#2a6bb0;">{$transaction.amount|number}</strong> {$transaction.currency}</td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">{{ phrase('opay.merchant_trade_no') }}</th>
					<td class="dataList-cell"><code>{$transaction.merchant_trade_no}</code></td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">{{ phrase('opay.trade_no') }}</th>
					<td class="dataList-cell"><xf:if is="$transaction.trade_no"><code>{$transaction.trade_no}</code><xf:else /><em>(尚未取得)</em></xf:if></td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">{{ phrase('opay.payment_type') }}</th>
					<td class="dataList-cell">
						<xf:if is="$transaction.payment_type">{$transaction.payment_type}
						<xf:elseif is="$transaction.payment_method" />{$transaction.payment_method}
						<xf:else /><em>(未指定)</em>
						</xf:if>
					</td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">{{ phrase('opay.purchaser') }}</th>
					<td class="dataList-cell">
						<xf:if is="$transaction.User"><a href="{{ link('users', $transaction.User) }}">{$transaction.User.username}</a>
						<xf:else />{$transaction.username}
						</xf:if>
						<span style="opacity:.6">(#{$transaction.user_id})</span>
					</td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">{{ phrase('opay.create_date') }}</th>
					<td class="dataList-cell"><xf:date time="{$transaction.create_date}" /></td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">{{ phrase('opay.payment_date') }}</th>
					<td class="dataList-cell">
						<xf:if is="$transaction.payment_date"><xf:date time="{$transaction.payment_date}" /><xf:else /><em>—</em></xf:if>
					</td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">{{ phrase('opay.note') }}</th>
					<td class="dataList-cell">
						<xf:if is="$transaction.admin_note">{$transaction.admin_note|nl2br}<xf:else /><em>(無備註)</em></xf:if>
					</td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">Request Key</th>
					<td class="dataList-cell"><code style="font-size:.85em; opacity:.7;">{$transaction.request_key}</code></td>
				</tr>
			</tbody>
		</table>
	</div>
</div>

<xf:if is="$transaction.status == 'pending' && $transaction.trade_no">
	<div class="blockMessage blockMessage--info">
		<h4 style="margin:0 0 8px 0;">本訂單已成立但尚未付款</h4>
		<p style="margin:0 0 8px 0;">OPay 端已收到此訂單並產生交易序號 <code>{$transaction.trade_no}</code>，但使用者尚未完成付款。</p>
		<p style="margin:0;">若您在 OPay 後台找不到此訂單，可能是後台預設僅顯示「已付款」的訂單。請：</p>
		<ul style="margin:6px 0 0 20px;">
			<li>在 {$diag.vendor_label}切換訂單狀態篩選為「<b>全部</b>」或「<b>未付款</b>」</li>
			<li>或直接以交易序號 <code>{$transaction.trade_no}</code> 搜尋</li>
			<li>或以商店訂單編號 <code>{$transaction.merchant_trade_no}</code> 搜尋</li>
		</ul>
	</div>
</xf:if>

<div class="block">
	<div class="block-container">
		<h2 class="block-header">診斷資訊</h2>
		<table class="dataList-table">
			<tbody>
				<tr class="dataList-row">
					<th class="dataList-cell" style="width:200px; font-weight:bold; background:#f7f7f7;">服務商</th>
					<td class="dataList-cell">
						<xf:if is="$diag.service_provider == 'ecpay'">ECPay 綠界<xf:else />OPay 歐付寶</xf:if>
						<span style="opacity:.6;">({$diag.service_provider})</span>
					</td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">環境</th>
					<td class="dataList-cell">
						<xf:if is="$diag.environment == 'production'"><span class="label label--green">正式環境 Production</span>
						<xf:else /><span class="label label--yellow">測試環境 Stage</span>
						</xf:if>
					</td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">CheckMacValue 加密</th>
					<td class="dataList-cell"><code>{$diag.encrypt_type|to_upper}</code></td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">API 端點</th>
					<td class="dataList-cell"><code>{$diag.api_host}</code></td>
				</tr>
				<tr class="dataList-row">
					<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">廠商後台</th>
					<td class="dataList-cell">
						<a href="{$diag.vendor_url}" target="_blank" rel="noopener">{$diag.vendor_label}</a>
						&nbsp; <span style="opacity:.6;">({$diag.vendor_url})</span>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</div>

<xf:if is="$transaction.extra_info">
	<div class="block">
		<div class="block-container">
			<h2 class="block-header">{{ phrase('opay_block.extra_info') }}</h2>
			<div class="block-body block-row">
				<pre style="white-space:pre-wrap; word-break:break-all; max-height:400px; overflow:auto; font-size:12px; background:#f7f7f7; padding:12px; border-radius:4px; margin:0;">{$transaction.extra_info|json}</pre>
			</div>
		</div>
	</div>
</xf:if>

<xf:if is="$logs is not empty">
	<div class="block">
		<div class="block-container">
			<h2 class="block-header">{{ phrase('opay_block.related_logs') }} <span class="block-headerCounter">({$logs|count})</span></h2>
			<table class="dataList-table">
				<thead>
					<tr class="dataList-row dataList-row--header">
						<th class="dataList-cell" style="width:170px;">時間</th>
						<th class="dataList-cell" style="width:90px;">類型</th>
						<th class="dataList-cell">訊息</th>
						<th class="dataList-cell" style="width:200px;">TradeNo</th>
					</tr>
				</thead>
				<tbody>
					<xf:foreach loop="$logs" value="$log">
						<tr class="dataList-row">
							<td class="dataList-cell"><xf:date time="{$log.log_date}" /></td>
							<td class="dataList-cell">
								<xf:if is="$log.log_type == 'payment'"><span class="label label--green">{$log.log_type}</span>
								<xf:elseif is="$log.log_type == 'error'" /><span class="label label--red">{$log.log_type}</span>
								<xf:elseif is="$log.log_type == 'cancel'" /><span class="label label--yellow">{$log.log_type}</span>
								<xf:else /><span class="label">{$log.log_type}</span>
								</xf:if>
							</td>
							<td class="dataList-cell">{$log.log_message}</td>
							<td class="dataList-cell"><code style="font-size:.85em;">{$log.transaction_id}</code></td>
						</tr>
					</xf:foreach>
				</tbody>
			</table>
		</div>
	</div>
</xf:if>
]]></template>

  <template type="admin" title="yucts_opay_order_edit" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:title>{{ phrase('edit') }}: {$transaction.merchant_trade_no}</xf:title>

<xf:form action="{{ link('opay/orders/edit', $transaction) }}" ajax="true" class="block">
	<div class="block-container">
		<div class="block-body">
			<xf:textarearow name="admin_note" value="{$transaction.admin_note}" rows="6" label="{{ phrase('opay.note') }}" />
		</div>
		<xf:submitrow sticky="true" />
	</div>
</xf:form>
]]></template>

  <template type="admin" title="yucts_opay_order_action" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:title>{$confirm}</xf:title>

<xf:form action="{$actionUrl}" class="block">
	<div class="block-container">
		<div class="block-body">
			<div class="blockMessage blockMessage--important">{$confirm}</div>
			<dl class="pairs pairs--rows pairs--fixedSmall">
				<dt>{{ phrase('opay.merchant_trade_no') }}</dt><dd>{$transaction.merchant_trade_no}</dd>
				<dt>{{ phrase('opay.amount') }}</dt><dd>{$transaction.amount|number} {$transaction.currency}</dd>
				<dt>{{ phrase('opay.purchaser') }}</dt><dd>{$transaction.username} (#{$transaction.user_id})</dd>
				<dt>{{ phrase('opay.status') }}</dt><dd>{$transaction.status_phrase}</dd>
			</dl>
			<xf:textarearow name="note" rows="3" label="{{ phrase('opay.note') }}" />
		</div>
		<xf:submitrow icon="save" submit="{{ phrase('confirm') }}" />
	</div>
</xf:form>
]]></template>

  <template type="admin" title="yucts_opay_order_query" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:title>{{ phrase('opay.query_result') }} — {$transaction.merchant_trade_no}</xf:title>

<xf:pageaction>
	<a href="{{ link('opay/orders/view', $transaction) }}" class="button button--link">&laquo; {{ phrase('back') }}</a>
	<a href="{{ link('opay/orders/query', $transaction) }}" class="button">重新查詢</a>
</xf:pageaction>

<div class="block">
	<div class="block-container">
		<h2 class="block-header">即時 OPay 回應</h2>
		<table class="dataList-table">
			<thead>
				<tr class="dataList-row dataList-row--header">
					<th class="dataList-cell" style="width:220px;">欄位</th>
					<th class="dataList-cell">值</th>
				</tr>
			</thead>
			<tbody>
				<xf:foreach loop="$rows" value="$row">
					<tr class="dataList-row">
						<td class="dataList-cell">
							<xf:if is="$row.labelZh">
								<strong>{$row.labelZh}</strong>
								<div class="u-muted" style="font-size:.85em;"><code>{$row.key}</code></div>
							<xf:else />
								<code>{$row.key}</code>
							</xf:if>
						</td>
						<td class="dataList-cell">
							<xf:if is="$row.value === ''">
								<em class="u-muted">(空)</em>
							<xf:else />
								<xf:if is="$row.key == 'CheckMacValue'">
									<code style="font-size:.8em; word-break:break-all;">{$row.value}</code>
								<xf:else />
									{$row.value}
								</xf:if>
								<xf:if is="$row.valueLabel">
									&nbsp;&mdash;&nbsp; <strong>{$row.valueLabel}</strong>
								</xf:if>
							</xf:if>
						</td>
					</tr>
				</xf:foreach>
			</tbody>
		</table>
	</div>
</div>

<div class="blockMessage blockMessage--info">
	此處顯示的是從 OPay 即時查詢的結果。如果 <code>TradeStatus</code> 顯示為「查無此訂單」，代表使用者點了「購買」按鈕但實際從未送出付款表單到 OPay (例如中途關閉視窗)。
</div>
]]></template>

  <template type="admin" title="yucts_opay_order_test" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:title>OPay 連線測試</xf:title>

<div class="blockMessage blockMessage--info">
	本頁會以您的設定，向 OPay 送出一筆「刻意不存在的訂單編號」進行查詢，藉此驗證：<br />
	1. <b>HashKey / HashIV / 加密類型</b>是否與 OPay 帳號一致<br />
	2. <b>網路 / API 端點</b>是否可達<br />
	3. <b>CheckMacValue 演算法</b>是否雙向正確<br /><br />
	正常的回應應為：OPay 回傳 <code>TradeStatus=10200047</code> (查無此訂單)，並通過 CheckMacValue 驗證。<br />
	若您看到 <b>「CheckMacValue 驗證失敗」</b>或 <b>「找不到特店」</b>，請依錯誤訊息檢查 MerchantID / HashKey / HashIV / 加密類型。
</div>

<xf:form action="{{ link('opay/test') }}" class="block">
	<div class="block-container">
		<h2 class="block-header">執行測試</h2>
		<div class="block-body">
			<xf:selectrow name="payment_profile_id"
				value="{$profile.payment_profile_id}"
				label="付款設定檔"
				explain="選擇您要測試的 OPay 付款設定檔。">
				<xf:foreach loop="$profiles" value="$p">
					<xf:option value="{$p.payment_profile_id}">
						{$p.title} (Merchant: {$p.options.merchant_id}, {{ $p.options.environment ?: 'stage' }}, {{ ($p.options.encrypt_type ?: 'sha256')|to_upper }})
					</xf:option>
				</xf:foreach>
			</xf:selectrow>
		</div>
		<xf:submitrow icon="search" submit="送出測試查詢" />
	</div>
</xf:form>

<xf:if is="$nonce">
	<div class="block">
		<div class="block-container">
			<h2 class="block-header">測試結果</h2>
			<table class="dataList-table">
				<tbody>
					<tr class="dataList-row">
						<th class="dataList-cell" style="width:200px; font-weight:bold; background:#f7f7f7;">使用的測試編號</th>
						<td class="dataList-cell"><code>{$nonce}</code> (刻意產生的不存在編號)</td>
					</tr>
					<tr class="dataList-row">
						<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">送出至</th>
						<td class="dataList-cell">
							<xf:if is="($profile.options.service_provider ?: 'opay') == 'ecpay'">
								<code><xf:if is="($profile.options.environment ?: 'stage') == 'production'">https://payment.ecpay.com.tw<xf:else />https://payment-stage.ecpay.com.tw</xf:if>/Cashier/QueryTradeInfo/V5</code>
							<xf:else />
								<code><xf:if is="($profile.options.environment ?: 'stage') == 'production'">https://payment.opay.tw<xf:else />https://payment-stage.opay.tw</xf:if>/Cashier/QueryTradeInfo/V5</code>
							</xf:if>
						</td>
					</tr>
					<tr class="dataList-row">
						<th class="dataList-cell" style="font-weight:bold; background:#f7f7f7;">結果</th>
						<td class="dataList-cell">
							<xf:if is="$errorMsg">
								<span class="label label--red">失敗</span>
								<div style="margin-top:8px; padding:8px; background:#fee; border-left:3px solid #dc322f; font-size:13px;">{$errorMsg}</div>
							<xf:elseif is="$result" />
								<span class="label label--green">通過</span>
								<div style="margin-top:4px; font-size:13px; color:#666;">
									OPay 收到請求並回應，CheckMacValue 雙向驗證通過。
									<xf:if is="$result.TradeStatus == '10200047'">
										回傳 <code>TradeStatus=10200047</code>（查無此訂單）—— 此為預期回應，代表您的整合設定完全正確！
									</xf:if>
								</div>

								<xf:if is="$result.TradeStatus == '10200047'">
									<div style="margin-top:14px; padding:12px; background:#f4f9ff; border-left:3px solid #2a6bb0; font-size:13px;">
										<b>下一步：</b> 連線測試通過僅代表「身分驗證」與「演算法」正確，**並不代表 OPay 帳號已允許您送出實際訂單**。<br /><br />

										若您點購買後 OPay 仍不建立訂單（後台查不到、TradeStatus 永遠 10200047），最常見原因是 OPay 帳號的「付款方式權限」不足。建議：
										<ol style="margin:8px 0 0 20px; padding:0;">
											<li>編輯此付款設定檔，「允許的付款方式」勾選<b>全部四種</b>（信用卡 + WebATM + ATM + CVS）後儲存</li>
											<li>重新進入 <code>/account/upgrades</code> 點購買，看 OPay 是否顯示<b>收銀台選單</b>（ALL 模式）</li>
											<li>分別選 ATM / CVS（這兩種多數帳號預設啟用且不需真實付款即可取號驗證）</li>
											<li>若 ATM / CVS 可取號但信用卡跳回，致電 <b>OPay 客服 02-2655-1775</b>，告知：<br />
												「我已完成 API 串接（QueryTradeInfo 可正常驗證 CheckMacValue），但 AioCheckOut Credit 訂單 OPay 端不建立訂單，請確認信用卡功能是否已啟用。」
											</li>
											<li>同時請至 OPay 廠商後台確認「<b>系統介接設定 / 回傳網址設定</b>」是否需要將您的網域（如 <code>https://yourdomain.com</code>）加入白名單。</li>
										</ol>
									</div>
								</xf:if>
							<xf:else />
								<em>尚未測試</em>
							</xf:if>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<xf:if is="$result">
		<div class="block">
			<div class="block-container">
				<h2 class="block-header">原始回應</h2>
				<table class="dataList-table">
					<tbody>
						<xf:foreach loop="$result" key="$k" value="$v">
							<tr class="dataList-row">
								<td class="dataList-cell" style="width:240px;"><code>{$k}</code></td>
								<td class="dataList-cell">
									<xf:if is="$v === ''"><em class="u-muted">(空)</em>
									<xf:else />{$v}
									</xf:if>
								</td>
							</tr>
						</xf:foreach>
					</tbody>
				</table>
			</div>
		</div>
	</xf:if>
</xf:if>
]]></template>

  <template type="admin" title="yucts_opay_order_logs" version_id="1000010" version_string="1.0.0"><![CDATA[<xf:title>{{ phrase('admin_navigation.yuctsOpayLog') }}</xf:title>

<div class="blockMessage blockMessage--info">
	此處顯示 <code>xf_payment_provider_log</code> 中所有 provider = <code>opay</code> 的紀錄；
	包括 OPay 主動 callback、後台手動操作 (退款 / 取消) 等。
</div>

<xf:if is="$logs is not empty">
	<div class="block">
		<div class="block-container">
			<h2 class="block-header">交易記錄 <span class="block-headerCounter">({$total|number})</span></h2>
			<table class="dataList-table">
				<thead>
					<tr class="dataList-row dataList-row--header">
						<th class="dataList-cell" style="width:160px;">時間</th>
						<th class="dataList-cell" style="width:90px;">類型</th>
						<th class="dataList-cell" style="width:200px;">TradeNo</th>
						<th class="dataList-cell" style="width:240px;">RequestKey</th>
						<th class="dataList-cell">訊息</th>
					</tr>
				</thead>
				<tbody>
					<xf:foreach loop="$logs" value="$log">
						<tr class="dataList-row">
							<td class="dataList-cell"><xf:date time="{$log.log_date}" /></td>
							<td class="dataList-cell">
								<xf:if is="$log.log_type == 'payment'"><span class="label label--green">{$log.log_type}</span>
								<xf:elseif is="$log.log_type == 'error'" /><span class="label label--red">{$log.log_type}</span>
								<xf:elseif is="$log.log_type == 'cancel'" /><span class="label label--yellow">{$log.log_type}</span>
								<xf:else /><span class="label">{$log.log_type}</span>
								</xf:if>
							</td>
							<td class="dataList-cell"><code>{$log.transaction_id}</code></td>
							<td class="dataList-cell"><code>{$log.purchase_request_key}</code></td>
							<td class="dataList-cell">{$log.log_message}</td>
						</tr>
					</xf:foreach>
				</tbody>
			</table>
		</div>
	</div>
	<xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="opay/logs" wrapperclass="block" />
<xf:else />
	<div class="blockMessage blockMessage--none">
		目前還沒有任何交易記錄。<br />
		當有使用者付款 (OPay 主動 callback) 或後台手動操作 (退款 / 取消) 時，這裡會出現對應的記錄。
	</div>
</xf:if>
]]></template>
</templates>
