  <phrase title="opay_atm_expire_date_explain" version_id="1000010" version_string="1.0.0"><![CDATA[ATM 虛擬帳號繳費期限，範圍 1~60 天 (預設 3 天)。]]></phrase>
  <phrase title="opay_cvs_expire_minutes" version_id="1000010" version_string="1.0.0"><![CDATA[超商代碼繳費期限 (分鐘)]]></phrase>
